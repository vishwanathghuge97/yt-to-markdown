# ==========================================
# OPTIONAL ENVIRONMENT VARIABLES
# ==========================================
# This app is bring-your-own-key (BYOK): every browser sends its own Gemini
# API key, and the server rejects Gemini requests without a caller key.
# No server-side Gemini key is required.

# GEMINI_API_KEY: Only needed for custom self-hosted forks that deliberately
# wire a shared server-side key. Leave unset for the default deployment.
# GEMINI_API_KEY=""

# APP_URL: Optional for self-referential links or deployment host.
APP_URL="https://your-app-domain.vercel.app"

# ==========================================
# REQUIRED FOR GOOGLE DRIVE FEATURES
# ==========================================
# Firebase web app configuration (Firebase Console -> Project settings ->
# Your apps -> Web app). Needed for Google sign-in and Drive export/sync.
# Notes generation works without these; Drive buttons then show a clear
# configuration error.
#
# Never commit real values: keep them in a local .env (gitignored) and in
# your hosting platform's Environment Variables (e.g. Vercel).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
