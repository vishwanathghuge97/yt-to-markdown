# ==========================================
# REQUIRED ENVIRONMENT VARIABLES
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI API calls on the backend.
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: Optional for self-referential links or deployment host.
APP_URL="https://your-app-domain.vercel.app"

# ==========================================
# OPTIONAL CLIENT-SIDE FIREBASE OVERRIDES
# ==========================================
# If not set, the app will fall back to firebase-applet-config.json.
# Set these in Vercel if you want to use your own custom Firebase project.
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
